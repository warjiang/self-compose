REGISTRY=docker.io

# Persistent data root on host.
GITLAB_HOME=./data

# Must be replaced with your real hostname or reachable IP/domain.
GITLAB_HOSTNAME=gitlab.example.com
GITLAB_EXTERNAL_URL=http://gitlab.example.com:8929

# Custom high ports to avoid conflicts with host 80/443/22.
GITLAB_HTTP_PORT=8929
GITLAB_HTTPS_PORT=2443
GITLAB_SSH_PORT=2424

# Pinned stable CE image tag.
GITLAB_IMAGE_TAG=19.0.0-ce.0
